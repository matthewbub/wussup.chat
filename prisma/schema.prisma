generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChatHistory {
  id       String   @id @default(uuid())
  userId   String
  chatName String @default("Untitled Chat")
  history  String
  updatedAt DateTime @updatedAt
}

model ApiKeys {
  id       String   @id @default(uuid())
  userId   String
  apiKey   String
  provider String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stats {
  id       String   @id @default(uuid())
  userId   String @unique
  lifetimeMessageCount Int @default(0)
  dailyMessageCount Int @default(0)
  dailyResetDate DateTime @default(now())
}

model Logs {
  id String @id @default(uuid())
  userId String
  message String
  createdAt DateTime @default(now())
}